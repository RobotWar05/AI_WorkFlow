{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/schemas/v1/eval-case.schema.json",
  "title": "Agent Eval Case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "objective", "mode", "fixture", "hard_guardrails", "outcome_checks", "trial_count", "budget"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "pattern": "^EVAL-[A-Z0-9-]+$"},
    "objective": {"type": "string", "minLength": 1},
    "mode": {"enum": ["single-owner", "manager-workers", "isolated-parallel", "peer-team-experimental"]},
    "fixture": {"type": "string", "minLength": 1},
    "hard_guardrails": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outcome_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "acceptable_variations": {"type": "array", "items": {"type": "string"}},
    "trial_count": {"type": "integer", "minimum": 1},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_turns", "max_minutes"], "properties": {"max_turns": {"type": "integer", "minimum": 1}, "max_minutes": {"type": "integer", "minimum": 1}, "max_tokens": {"type": ["integer", "null"], "minimum": 1}}}
  }
}
