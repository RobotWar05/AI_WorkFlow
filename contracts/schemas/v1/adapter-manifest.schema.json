{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/schemas/v1/adapter-manifest.schema.json",
  "title": "Runtime Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "adapter_version", "supported_version_range", "maturity", "capabilities", "field_mapping", "unsupported_fields", "fallback_policy", "generated_paths", "validator", "verified_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "runtime": {"enum": ["codex", "claude", "antigravity"]},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "supported_version_range": {"type": "string", "minLength": 1},
    "maturity": {"enum": ["static-only", "smoke-tested", "runtime-validated", "experimental"]},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "field_mapping": {"type": "object", "additionalProperties": {"type": "string"}},
    "unsupported_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "fallback_policy": {"enum": ["fail-closed", "warn-and-require-approval"]},
    "generated_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validator": {"type": "string", "minLength": 1},
    "verified_at": {"type": ["string", "null"], "format": "date"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
