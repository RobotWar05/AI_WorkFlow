{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/schemas/v1/handoff.schema.json",
  "title": "Worker Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "task_id", "from", "to", "status", "result", "artifacts", "files_touched", "decisions", "checks", "assumptions", "unknowns", "remaining", "risks", "conflicts", "approvals", "integration_notes", "next_action", "base_revision"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "handoff_id": {"type": "string", "pattern": "^HO-[A-Z0-9-]+$"},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
    "delegation_id": {"type": ["string", "null"]},
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "blocked", "failed", "needs-rework", "partial"]},
    "result": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "files_touched": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "evidence", "result"],
        "properties": {"command": {"type": "string"}, "exit_code": {"type": ["integer", "null"]}, "evidence": {"type": "string", "minLength": 1}, "result": {"enum": ["passed", "failed", "inconclusive", "skipped"]}}
      }
    },
    "acceptance_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "result", "evidence"],
        "properties": {"criterion_id": {"type": "string", "pattern": "^AC-[0-9]+$"}, "result": {"enum": ["passed", "failed", "inconclusive"]}, "evidence": {"type": "string", "minLength": 1}}
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "remaining": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "string"}},
    "integration_notes": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string", "minLength": 1},
    "base_revision": {"type": ["string", "null"]},
    "output_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {
        "required": ["acceptance_results"],
        "properties": {
          "checks": {"minItems": 1},
          "acceptance_results": {"minItems": 1, "items": {"properties": {"result": {"const": "passed"}}}},
          "remaining": {"maxItems": 0},
          "conflicts": {"maxItems": 0}
        }
      }
    }
  ]
}
