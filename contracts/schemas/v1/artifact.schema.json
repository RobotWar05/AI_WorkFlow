{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/schemas/v1/artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "task_id", "producer", "kind", "revision", "location", "format", "summary", "provenance", "acceptance_refs", "verification_evidence", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {"type": "string", "pattern": "^ART-[A-Z0-9-]+$"},
    "task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
    "producer": {"type": "string", "minLength": 1},
    "kind": {"enum": ["source", "patch", "document", "research", "design", "test-result", "log", "binary", "manifest"]},
    "revision": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "format": {"type": "string", "minLength": 1},
    "classification": {"enum": ["public", "internal", "private", "secret"]},
    "summary": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "consumers": {"type": "array", "items": {"type": "string"}},
    "acceptance_refs": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]+$"}},
    "verification_evidence": {"type": "array", "items": {"type": "string"}},
    "digest_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["draft", "submitted", "accepted", "rejected", "superseded"]}
  }
}
