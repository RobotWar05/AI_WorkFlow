{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/schemas/v1/tool-contract.schema.json",
  "title": "Tool Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_id", "purpose", "input_schema", "output_schema", "side_effect", "timeout_seconds", "idempotency", "approval", "errors"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tool_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "purpose": {"type": "string", "minLength": 1},
    "input_schema": {"type": "string", "minLength": 1},
    "output_schema": {"type": "string", "minLength": 1},
    "side_effect": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7"]},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "idempotency": {"enum": ["idempotent", "key-required", "not-idempotent", "unknown"]},
    "dry_run": {"type": "boolean"},
    "approval": {"enum": ["none", "task-scope", "action-time"]},
    "errors": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"side_effect": {"enum": ["E2", "E3", "E4", "E5", "E6", "E7"]}}, "required": ["side_effect"]},
      "then": {"properties": {"approval": {"const": "action-time"}}}
    }
  ]
}
