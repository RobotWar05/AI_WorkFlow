{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workflow.local/schemas/v1/delegation-packet.schema.json",
  "title": "Delegation Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "delegation_id", "parent_task_id", "delegate", "role", "objective", "read_set", "write_set", "forbidden_actions", "workspace_isolation", "budget", "acceptance_criteria", "stop_conditions", "escalation_conditions", "return_contract"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "delegation_id": {"type": "string", "pattern": "^DEL-[A-Z0-9-]+$"},
    "parent_task_id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
    "delegate": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "why_delegate": {"type": "string"},
    "objective": {"type": "string", "minLength": 1},
    "task_specific_context": {"type": "array", "items": {"type": "string"}},
    "read_set": {"type": "array", "items": {"type": "string"}},
    "write_set": {"type": "array", "items": {"type": "string"}},
    "required_skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "tools_allowed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "tools_denied": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_actions": {"type": "array", "items": {"type": "string"}},
    "max_effect_class": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7"]},
    "workspace_isolation": {"enum": ["shared-read", "exclusive-path", "worktree", "sandbox"]},
    "base_revision": {"type": ["string", "null"]},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_turns", "max_minutes"],
      "properties": {"max_turns": {"type": "integer", "minimum": 1}, "max_minutes": {"type": "integer", "minimum": 1}, "max_tokens": {"type": ["integer", "null"], "minimum": 1}}
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AC-[0-9]+$"}},
    "expected_artifacts": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "escalation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "return_contract": {"enum": ["handoff/v1", "artifact+handoff/v1", "research-report/v1"]}
  },
  "allOf": [
    {
      "if": {"properties": {"workspace_isolation": {"const": "worktree"}}, "required": ["workspace_isolation"]},
      "then": {"required": ["base_revision"], "properties": {"base_revision": {"type": "string", "minLength": 1}}}
    }
  ]
}
